# Auto detect text files and force LF line endings on checkout,
# regardless of each dev's local core.autocrlf setting.
* text=auto eol=lf

# Development-only files: kept in the repo, left out of the archives GitHub
# builds (zipball / tarball), which is what the deploy installs on the server.
# None of them is read by WordPress; several are internal notes that would
# otherwise be publicly reachable under /wp-content/themes/montela/.
/.claude                            export-ignore
/.vscode                            export-ignore
/.editorconfig                      export-ignore
/.gitattributes                     export-ignore
/.gitignore                         export-ignore
/CLAUDE.md                          export-ignore
/NOTES.txt                          export-ignore
/TODO.md                            export-ignore
/WORKFLOW.md                        export-ignore
/SETUP.md                           export-ignore
/README.md                          export-ignore
/figma-architecture-analysis.txt    export-ignore
/vite.config.mjs                    export-ignore
/tailwind.config.js                 export-ignore
/package.json                       export-ignore
/package-lock.json                  export-ignore
/composer.json                      export-ignore
/composer.lock                      export-ignore
/phpcs.xml.dist                     export-ignore
